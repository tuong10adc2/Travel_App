rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isContentEditor() {
      return isSignedIn() && userRole() in ['admin', 'content_editor'];
    }

    function isSupport() {
      return isSignedIn() && userRole() in ['admin', 'support'];
    }

    // ---------- users/{userId} ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSupport();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.isDisabled == false;

      // Chủ tài khoản được sửa hồ sơ của mình nhưng không được tự đổi role/isDisabled.
      allow update: if (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.isDisabled == resource.data.isDisabled)
        || isAdmin();

      allow delete: if isAdmin();

      // ---------- users/{userId}/chat_history/{sessionId} ----------
      match /chat_history/{sessionId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
          allow read: if isAdmin();
        }
      }
    }

    // ---------- places/{placeId} ----------
    match /places/{placeId} {
      allow read: if resource.data.isActive == true || isContentEditor();
      allow create, update, delete: if isContentEditor();
    }

    // ---------- media_360/{mediaId} ----------
    match /media_360/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isContentEditor();
    }

    // ---------- tours/{tourId} ----------
    match /tours/{tourId} {
      allow read: if resource.data.isActive == true || isContentEditor();
      allow create, update, delete: if isContentEditor();
    }

    // ---------- itineraries/{itineraryId} ----------
    match /itineraries/{itineraryId} {
      allow read: if isOwner(resource.data.userId) || resource.data.isShared == true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);

      // ---------- itineraries/{itineraryId}/itinerary_items/{itemId} ----------
      match /itinerary_items/{itemId} {
        allow read: if isOwner(get(/databases/$(database)/documents/itineraries/$(itineraryId)).data.userId)
          || get(/databases/$(database)/documents/itineraries/$(itineraryId)).data.isShared == true;
        allow write: if isOwner(get(/databases/$(database)/documents/itineraries/$(itineraryId)).data.userId);
      }
    }

    // ---------- reviews/{reviewId} ----------
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.userId)
        || isSupport();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Chủ review được sửa nội dung nhưng không tự duyệt; support/admin điều chỉnh status.
      allow update: if (isOwner(resource.data.userId)
          && request.resource.data.status == resource.data.status)
        || isSupport();

      allow delete: if isOwner(resource.data.userId) || isSupport();
    }

    // ---------- saved_places/{savedId} ----------
    match /saved_places/{savedId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }
  }
}
